# ── Logs ──────────────────────────────────────────────────────────────────────
app.log
app_py.log
app.log.*
logs/
*.log

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
src/__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
*.egg-info/
dist/
build/

# ── Secrets and credentials — NEVER commit these ──────────────────────────────
# config.json is the live config that contains real DB passwords, JWT secrets,
# and API credentials. Only config.dev.json (with placeholder values) is tracked.
config.json

# Environment files
.env
.env.*
!.env.example          # .env.example is safe — it contains no real values

# Key and certificate files
*.key
*.pem
*.p12
*.pfx
secrets.json
credentials.json
.htpasswd

# detect-secrets — baseline tracks known-safe findings
# .secrets.baseline is committed so the pre-commit hook has a reference point

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Project-specific ──────────────────────────────────────────────────────────
audio/
audio.zip
reports/
bin/asterisk-googletts
config.ini
*.bak
