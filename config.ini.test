; Make sure that you have the right persmissions to access this file by running:
; chown -R asterisk ivr
; This command shall give ownership of the cloned ivr folder to the "asterisk" user to make changes to that directory.

; This is the demo config.ini.test file. Create a copy of this file using the command:
; cp config.ini.test config.ini

; This is ths file you shall modify with the existing configs you have on your machine.
; Its been ignored in .gitignore so any changes to "config.ini" wont be commited.

; Simply replace audio_path with your home audio path e.g. /home/asteriskidi/audio
[app]
audio_path = /var/www/html/audio

; Do not use this config (redis_host, redis_port) for any new feature. Use the config under redis section [redis]
redis_host = 127.0.0.1
redis_port = 6379

[redis]
host = 172.17.0.1
port = 6379

[database]
port = 3306
hostname = 172.17.0.1
username = root
password = root
database = ivr


; Navigate to /etc/asterisk/manager.conf and modify your AMI credentials as you see fit
[ami]
user = ivr
pass = 1234
sip_trunk_number =
host = 127.0.0.1
port = 5038
trunk =

; This is the name of the Machine this IVR Repo is running on e.g. "Staging_MKC"
[host_machine]
name = name_of_host_machine

; Configure email credentials
[email]
username = academysupport@idi.co.ug
password = provide_email_password_here
port = 587
host = smtp.office365.com

[daily_reports_email]
; Must be in this format
to_recipients = example1@gmail.com,example2@gmail.com
cc_recipients = example1@gmail.com,example2@gmail.com
